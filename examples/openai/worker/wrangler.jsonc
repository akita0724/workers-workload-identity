{
  "name": "wif-probe-openai",
  "main": "index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "services": [
    {
      "binding": "OIDC_ISSUER",
      "service": "oidc",
      "entrypoint": "IssuerRpc",
      "props": {
        "clientId": "probe-openai"
      }
    }
  ],
  "vars": {
    "AUDIENCE": "https://api.openai.com/v1",
    "OPENAI_PROVIDER_ID": "REPLACE",
    "OPENAI_SERVICE_ACCOUNT_ID": "REPLACE"
  }
}
