{
  "name": "wif-probe-claude",
  "main": "index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "services": [
    {
      "binding": "OIDC_ISSUER",
      "service": "oidc",
      "entrypoint": "IssuerRpc",
      "props": {
        "clientId": "probe-claude"
      }
    }
  ],
  "vars": {
    "AUDIENCE": "urn:example:claude:staging",
    "CLAUDE_RULE_ID": "fdrl_REPLACE",
    "CLAUDE_ORGANIZATION_ID": "00000000-0000-0000-0000-000000000000",
    "CLAUDE_SERVICE_ACCOUNT_ID": "svac_REPLACE",
    "CLAUDE_WORKSPACE_ID": "wrkspc_REPLACE"
  }
}
