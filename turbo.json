{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "validate": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["WRANGLER_LOG_PATH", "WRANGLER_SEND_METRICS"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "domain": {
        "dependencies": {
          "deny": ["contract", "adapter", "ui", "docs", "client"]
        }
      },
      "contract": {
        "dependencies": {
          "deny": ["adapter", "ui", "docs", "client"]
        }
      },
      "ui": {
        "dependencies": {
          "allow": ["contract"]
        }
      },
      "adapter": {
        "dependencies": {
          "allow": ["domain", "contract", "client"]
        }
      },
      "docs": {
        "dependencies": {
          "deny": ["domain", "contract", "adapter", "ui", "client"]
        }
      },
      "client": {
        "dependencies": {
          "allow": ["contract"]
        }
      }
    }
  }
}
